; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ODISPEL"
run/main_scene="uid://io8v28y1efyh"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/show_image=true
boot_splash/image="res://assets/boot/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.0156863, 0.0313726, 0.0392157, 1)

[autoload]

CampaignState="*uid://c8lloqc2i0mu2"
SaveManager="*uid://cuv5g44srpksk"
NetSession="*uid://pygfm6l0g37o"
Feedback="*res://scripts/ui/feedback.gd"
Sfx="*res://scripts/audio/audio_manager.gd"

[display]

window/handheld/orientation=0

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/max_log_files=5

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

environment/defaults/default_clear_color=Color(0.0431373, 0.0470588, 0.0705882, 1)

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
